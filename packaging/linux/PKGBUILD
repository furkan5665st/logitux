pkgname=logitux
pkgver=0.4.1
pkgrel=1
pkgdesc="Logitech mouse configuration tool"
arch=('x86_64')
url="https://github.com/furkan5665st/logitux"
license=('MIT' 'Apache-2.0')
depends=('libxkbcommon' 'wayland' 'libx11' 'libglvnd')
makedepends=('cargo' 'pkgconf')
source=()

build() {
  cd "$startdir/../.."
  cargo build --release --locked --workspace
}

package() {
  cd "$startdir/../.."
  install -Dm755 target/release/logitux-gui "$pkgdir/usr/bin/logitux-gui"
  install -Dm755 target/release/logitux "$pkgdir/usr/bin/logitux"
  install -Dm644 udev/60-logitux.rules "$pkgdir/usr/lib/udev/rules.d/60-logitux.rules"
  install -Dm644 assets/logitux.desktop "$pkgdir/usr/share/applications/logitux.desktop"
  install -Dm644 assets/logitux.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/logitux.png"
}
