# LogiTux udev rules for non-root HID++ access on Linux (Fedora, Arch, Ubuntu, Debian, etc.)
# Install on Fedora / systemd distros:
#   sudo cp udev/99-logitux.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# USB wired Logitech mice and wireless receivers (Lightspeed, Unifying, Logi Bolt, Powerplay)
ACTION=="add|change", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", TAG+="uaccess"

# Bluetooth / BLE Logitech mice (e.g. MX Master 3S, G604, M-series over HID-over-GATT)
ACTION=="add|change", SUBSYSTEM=="hidraw", KERNELS=="0005:046D:*", TAG+="uaccess"

# Logitech HID++ kernel driver child hidraw nodes (hid-logitech-hidpp / hid-logitech-dj)
ACTION=="add|change", SUBSYSTEM=="hidraw", DRIVERS=="logitech-hidpp-device|logitech-djdevice|logitech-djreceiver", TAG+="uaccess"

# Virtual input device (/dev/uinput) for Wayland & X11 host-mode macros, shortcuts, and G-Shift
KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", TAG+="uaccess"
