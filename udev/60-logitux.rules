KERNEL=="uinput", SUBSYSTEM=="misc", OPTIONS+="static_node=uinput", MODE="0666", TAG+="uaccess"
ACTION=="remove", GOTO="logitux_end"
SUBSYSTEM!="hidraw", GOTO="logitux_end"
ATTRS{idVendor}=="046d", GOTO="logitux_apply"
ATTRS{idVendor}=="046D", GOTO="logitux_apply"
ATTRS{idVendor}=="17ef", ATTRS{idProduct}=="6042", GOTO="logitux_apply"
KERNELS=="*:046D:*", GOTO="logitux_apply"
KERNELS=="*:046d:*", GOTO="logitux_apply"
DRIVERS=="logitech-hidpp-device|logitech-djdevice|logitech-djreceiver", GOTO="logitux_apply"
GOTO="logitux_end"
LABEL="logitux_apply"
MODE="0666", TAG+="uaccess"
LABEL="logitux_end"
